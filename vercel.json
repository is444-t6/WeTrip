{
  "rewrites": [
    {
      "source": "/api/family/:path*",
      "destination": "/api/proxy?service=family&path=:path*"
    },
    {
      "source": "/api/fx/:path*",
      "destination": "/api/proxy?service=fx&path=:path*"
    },
    {
      "source": "/api/budget/:path*",
      "destination": "/api/proxy?service=budget&path=:path*"
    },
    {
      "source": "/api/trip/:path*",
      "destination": "/api/proxy?service=trip&path=:path*"
    },
    {
      "source": "/api/insurance/:path*",
      "destination": "/api/proxy?service=insurance&path=:path*"
    },
    {
      "source": "/scantopay/:path*",
      "destination": "/api/proxy?service=scantopay&path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
