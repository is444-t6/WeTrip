{
  "name": "wetrip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "dev:https": "bun --bun vite --config vite.config.https.js",
    "build": "bun --bun vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install || exit 0",
    "preview": "bun --bun vite preview",
    "test:atomic": "bun --env-file=.env.local scripts/test-atomic.mjs",
    "test:composite": "bun --env-file=.env.local scripts/test-composite.mjs",
    "test:trip": "bun --env-file=.env.local scripts/test-trip.mjs",
    "demo:market": "bun --env-file=.env.local scripts/demo-market.mjs",
    "test:smartfx": "playwright test tests/smartfx-api.spec.js",
    "test:ui": "playwright test tests/family.spec.js",
    "test:ui:mocked": "playwright test tests/family-mocked.spec.js",
    "test:e2e": "playwright test --project=mocked && playwright test --project=live --workers=1",
    "test:ui:report": "playwright show-report",
    "test:mocked": "playwright test --project=mocked"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "html5-qrcode": "2.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vite": "^8.3.8"
  }
}
