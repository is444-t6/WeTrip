{
  "name": "wetrip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --config vite.config.https.js",
    "build": "vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install || exit 0",
    "preview": "vite preview",
    "test:atomic": "node --env-file=.env.local scripts/test-atomic.mjs",
    "test:composite": "node --env-file=.env.local scripts/test-composite.mjs",
    "test:smartfx": "playwright test tests/smartfx-api.spec.js",
    "test:ui": "playwright test tests/family.spec.js",
    "test:ui:mocked": "playwright test tests/family-mocked.spec.js",
    "test:e2e": "playwright test",
    "test:ui:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "html5-qrcode": "2.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
