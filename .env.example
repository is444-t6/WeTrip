# One key for every WeTrip module, read on the server only (vite.config.js in dev,
# api/proxy.js on Vercel) and never bundled into the browser. Each module's key
# site property is set to this same value in Service Center.
WETRIP_SERVER_KEY=

# Older per-service keys, used only when WETRIP_SERVER_KEY is unset.

# WeTrip_Family_Composite -> Family REST API
VITE_FAMILY_API_KEY=

# WeTrip_SmartFX_Composite -> SmartFX REST API (defaults to the /api/fx dev proxy)
VITE_FX_API_KEY=

# WeTrip_Insurance_Composite -> InsuranceAPI REST API

# ScanToPay -> ScanToPay REST API (defaults to the /scantopay dev proxy)
VITE_SCANTOPAY_KEY=

# WeTrip_Budget_Composite -> Budget REST API (defaults to /api/budget)
VITE_BUDGET_API_KEY=
