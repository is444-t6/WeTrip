<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-container" name="C4 Container">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;WeTrip — Container Diagram (C4 Level 2)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#251b40;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Static SPA on Vercel, one serverless proxy, six OutSystems composites, three atomic modules and the SMUtBank sandbox." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b6280;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="parent" value="&lt;b&gt;Parent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7ff;strokeColor=#7041f2;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="child" value="&lt;b&gt;Child&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dffbf2;strokeColor=#10dbac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="&lt;b&gt;User&apos;s browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7041f2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontColor=#7041f2;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="420" height="520" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="&lt;b&gt;WeTrip SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: React 19 + Vite 8]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;TanStack Router routes, TanStack Query&lt;br&gt;cache, all screens and client validation.&lt;br&gt;Talks only to same-origin API paths;&lt;br&gt;never holds a composite key.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#531e8f;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;Browser storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Web Storage]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;sessionStorage: wetrip_session token,&lt;br&gt;insurance draft / trip / purchase result&lt;br&gt;localStorage: balance-hide preference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f1fb;strokeColor=#b9a7d4;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="vercel" value="&lt;b&gt;Vercel — production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#531e8f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontColor=#531e8f;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="390" height="360" as="geometry" />
        </mxCell>
        <mxCell id="static" value="&lt;b&gt;Static hosting / CDN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Vercel static]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;Serves dist/ (hashed JS, CSS, fonts)&lt;br&gt;and the SPA fallback /(.*) → index.html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="200" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;api/proxy.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Node.js serverless function]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;Forwards method, body, Content-Type&lt;br&gt;and X-Session-Token; injects&lt;br&gt;WETRIP_SERVER_KEY server-side.&lt;br&gt;502 on upstream failure.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="350" width="330" height="140" as="geometry" />
        </mxCell>

