        <mxCell id="a-family" value="&lt;b&gt;WeTrip_Family_Atomic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;FamilyLink · Budget · SpendLog · SpendRequest&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9a7d4;fontColor=#251b40;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="670" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-fx" value="&lt;b&gt;WeTrip_SmartFX_Atomic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;Trip · TripLock · TripSpend&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9a7d4;fontColor=#251b40;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="718" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-budget" value="&lt;b&gt;WeTrip_Budget_Atomic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;Category budgets · expense ledger&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9a7d4;fontColor=#251b40;fontFamily=Helvetica;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="766" width="460" height="40" as="geometry" />
        </mxCell>

        <mxCell id="tbank" value="&lt;b&gt;SMUtBank sandbox (tBank)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;MarketData · FXForward · Deposit Account · Payments · Customer · StandingInstruction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#8c8c8c;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="910" width="560" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e-parent" value="Uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7041f2;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="parent" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-child" value="Uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#10dbac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=11;" edge="1" parent="1" source="child" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-store" value="Reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b9a7d4;strokeWidth=1.5;dashed=1;fontColor=#6b6280;fontFamily=Helvetica;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="spa" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-proxy" value="fetch /api/&lt;service&gt;/* and /scantopay/*&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;same origin, JSON, X-Session-Token&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#531e8f;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="spa" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-composites" value="REST / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6d37ac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="proxy" target="composites">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-atomics" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b9a7d4;strokeWidth=1.5;fontColor=#6b6280;fontFamily=Helvetica;fontSize=10;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="composites" target="atomics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-tbank" value="gateway REST (Family / SmartFX / Trip)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8c8c8c;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=11;exitX=1;exitY=0.8;entryX=1;entryY=0.2;" edge="1" parent="1" source="composites" target="tbank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Vercel rewrites&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;/api/family · /api/fx · /api/budget · /api/trip · /api/insurance · /scantopay → /api/proxy?service=…&amp;amp;path=…&lt;br&gt;Dev uses the same map through the Vite server proxy (vite.config.js), so behaviour matches production.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d3;strokeColor=#e0b85c;dashed=1;fontColor=#251b40;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="600" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Trust boundary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6b6280&quot;&gt;Each owning module has its own database; tables are never exposed directly. Composite keys are added by the proxy;&lt;br&gt;the SPA sends an unsigned stub token that ValidateSessionStub parses. Demo-grade auth.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d3;strokeColor=#e0b85c;dashed=1;fontColor=#251b40;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="600" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
