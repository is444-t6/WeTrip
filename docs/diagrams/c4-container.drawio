          <mxGeometry x="1270" y="550" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="atomics" value="&lt;b&gt;Atomic modules (each owns its own database)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b9a7d4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6d37ac;fontStyle=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
