        <mxCell id="design" value="&lt;b&gt;Design system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;src/index.css tokens + classes,&lt;br&gt;Poppins, no UI kit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
