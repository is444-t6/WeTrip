<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-component" name="C4 Component">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;WeTrip — Component Diagram (C4 Level 3)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#251b40;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Inside the React SPA and the serverless proxy. Feature modules own screens plus their api.js / queries.js; all HTTP funnels through one client." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b6280;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="980" height="24" as="geometry" />
        </mxCell>

        <mxCell id="spa-boundary" value="&lt;b&gt;WeTrip SPA — browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#531e8f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontColor=#531e8f;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="960" height="820" as="geometry" />
        </mxCell>

        <mxCell id="router" value="&lt;b&gt;TanStack Router&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;20 thin file routes + routeTree.gen.ts;&lt;br&gt;per-screen isLoggedIn() guard, no loaders&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="shell" value="&lt;b&gt;AppShell + shared kit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;navbar, Money, Banner,&lt;br&gt;BalanceHero, SignedOutCard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="250" height="100" as="geometry" />
