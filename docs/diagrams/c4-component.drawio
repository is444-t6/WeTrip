        <mxCell id="f-ins" value="&lt;b&gt;Insurance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;plan → travellers →&lt;br&gt;quote → purchase&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#efe7ff;strokeColor=#7041f2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;fontSize=11;" vertex="1" parent="1">
