          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-fetch" value="fetch, same origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#531e8f;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="http" target="handler">
          <mxGeometry relative="1" as="geometry" />
