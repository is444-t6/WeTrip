        </mxCell>
        <mxCell id="http" value="&lt;b&gt;http.js client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;createClient / call / qs; decap() response casing;&lt;br&gt;friendlyError(); X-Session-Token or ?sessionToken=; no timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dffbf2;strokeColor=#10dbac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="680" width="590" height="105" as="geometry" />
        </mxCell>

        <mxCell id="proxy-boundary" value="&lt;b&gt;api/proxy.js — Vercel function&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6d37ac;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontColor=#6d37ac;fontStyle=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="260" width="380" height="520" as="geometry" />
        </mxCell>
        <mxCell id="handler" value="&lt;b&gt;handler(req, res)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;reads ?service &amp;amp; ?path, forwards&lt;br&gt;method / body / Content-Type /&lt;br&gt;X-Session-Token, returns upstream bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="320" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="upstream" value="&lt;b&gt;_services.js upstream()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;ORIGIN + six service paths;&lt;br&gt;injects WETRIP_SERVER_KEY as&lt;br&gt;X-Contacts-Key or apiKey query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
