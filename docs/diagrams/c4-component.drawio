        <mxCell id="env" value="&lt;b&gt;WETRIP_SERVER_KEY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;Vercel project environment,&lt;br&gt;server-side only — never in the bundle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2d3;strokeColor=#e0b85c;dashed=1;fontColor=#251b40;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="630" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="outsystems" value="&lt;b&gt;OutSystems composites&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;Family · SmartFX · Trip ·&lt;br&gt;Budget · Insurance · ScanToPay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f1fb;strokeColor=#6d37ac;strokeWidth=2;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1540" y="400" width="230" height="150" as="geometry" />
