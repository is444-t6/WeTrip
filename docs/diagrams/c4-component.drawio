          <mxGeometry x="815" y="330" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-note" value="&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;Each module keeps its screen(s), an api.js bound to serviceClient(), and a queries.js of TanStack Query keys + invalidation. Home and Auth sit alongside them.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6b6280;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="425" width="560" height="55" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;Auth / session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;session.js token in sessionStorage,&lt;br&gt;accounts.js lookup, useCurrentUser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="540" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="query" value="&lt;b&gt;TanStack Query cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;retry 1, staleTime 15 s, no focus refetch;&lt;br&gt;keys ['family'|'fx'|'budget'|'trip'|…]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="services" value="&lt;b&gt;services.js registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#6b6280&quot;&gt;base path, auth style, normalize;&lt;br&gt;serviceClient(name, overrides)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d37ac;fontColor=#251b40;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
